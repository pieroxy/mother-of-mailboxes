{
  "dataFolder": "/var/lib/mom",
  "keepLogFiles": 14,
  "classifierCorpusRetentionDays": 90,
  "webServer": {
    "enabled": false,
    "httpPort": 8080,
    "address": "127.0.0.1",
    "credentials": "webui"
  },
  "reputationLists": [
    {
      "id": "spamhaus-drop",
      "type": "IP_CIDR",
      "url": "https://www.spamhaus.org/drop/drop.txt",
      "refreshHours": 24,
      "score": 1.0
    },
    {
      "id": "blocklist-de-mail",
      "type": "IP_CIDR",
      "url": "https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/blocklist_de_mail.ipset",
      "refreshHours": 24,
      "score": 1.0
    },
    {
      "id": "hagezi-tif-mini",
      "type": "DOMAIN",
      "url": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/tif.mini-onlydomains.txt",
      "refreshHours": 24,
      "score": 1.0
    },
    {
      "id": "blocklist-project-phishing",
      "type": "DOMAIN",
      "url": "https://blocklistproject.github.io/Lists/alt-version/phishing-nl.txt",
      "refreshHours": 24,
      "score": 1.0
    },
    {
      "id": "disposable-email-domains",
      "type": "DOMAIN",
      "url": "https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/master/disposable_email_blocklist.conf",
      "refreshHours": 24,
      "score": 1.0
    },
    {
      "id": "hagezi-nrd7",
      "type": "DOMAIN",
      "url": "https://cdn.jsdelivr.net/gh/hagezi/nrd@latest/domains/nrd7.txt",
      "refreshHours": 24,
      "score": 1.0
    }
  ],
  "configurations": [
    {
      "displayName": "personal",
      "host": "imap.example.com",
      "port": 993,
      "credentials": "personal",
      "runEvery": 300,
      "classifierExcludedFolders": ["SpamML"],
      "rules": [
        {
          "matcher": { "type": "SPF_RESULT_EQUALS", "key": "fail" },
          "action": { "type": "MOVE_TO_AND_READ", "key": "Spam" }
        },
        {
          "matcher": { "type": "DKIM_RESULT_EQUALS", "key": "fail" },
          "action": { "type": "MOVE_TO_AND_READ", "key": "Spam" }
        },
        {
          "matcher": {
            "type": "AND",
            "children": [
              { "type": "DMARC_RESULT_EQUALS", "key": "fail" },
              { "type": "DMARC_POLICY_EQUALS", "key": "reject" }
            ]
          },
          "action": { "type": "MOVE_TO_AND_READ", "key": "Spam" }
        },
        {
          "matcher": {
            "type": "AND",
            "children": [
              { "type": "DMARC_RESULT_EQUALS", "key": "fail" },
              { "type": "DMARC_POLICY_EQUALS", "keys": ["quarantine", "none"] }
            ]
          },
          "action": { "type": "MOVE_TO", "key": "Spam" }
        },
        {
          "matcher": {
            "type": "AND",
            "children": [
              { "type": "SPF_RESULT_EQUALS", "key": "softfail" },
              { "type": "FCRDNS_RESULT_EQUALS", "keys": ["fail", "none"] }
            ]
          },
          "action": { "type": "MOVE_TO", "key": "Spam" }
        },
        {
          "matcher": { "type": "SUBJECT_CLASSIFIER_EQUALS", "key": ">0.99" },
          "action": { "type": "MOVE_TO_AND_READ", "key": "SpamML" }
        },
        {
          "matcher": {
            "type": "AND",
            "children": [
              { "type": "IP_REPUTATION_EQUALS", "listIds": ["spamhaus-drop"], "key": ">0.5" },
              { "type": "IP_REPUTATION_EQUALS", "listIds": ["blocklist-de-mail"], "key": ">0.5" }
            ]
          },
          "action": { "type": "MOVE_TO_AND_READ", "key": "Spam" }
        },
        {
          "matcher": {
            "type": "OR",
            "children": [
              { "type": "IP_REPUTATION_EQUALS", "listIds": ["spamhaus-drop"], "key": ">0.5" },
              { "type": "IP_REPUTATION_EQUALS", "listIds": ["blocklist-de-mail"], "key": ">0.5" }
            ]
          },
          "action": { "type": "MOVE_TO", "key": "Spam" }
        },
        {
          "matcher": {
            "type": "AND",
            "children": [
              { "type": "FROM_DOMAIN_REPUTATION_EQUALS", "listIds": ["hagezi-tif-mini"], "key": ">0.5" },
              { "type": "FROM_DOMAIN_REPUTATION_EQUALS", "listIds": ["blocklist-project-phishing"], "key": ">0.5" }
            ]
          },
          "action": { "type": "MOVE_TO_AND_READ", "key": "Spam" }
        },
        {
          "matcher": {
            "type": "OR",
            "children": [
              { "type": "FROM_DOMAIN_REPUTATION_EQUALS", "listIds": ["hagezi-tif-mini"], "key": ">0.5" },
              { "type": "FROM_DOMAIN_REPUTATION_EQUALS", "listIds": ["blocklist-project-phishing"], "key": ">0.5" }
            ]
          },
          "action": { "type": "MOVE_TO", "key": "Spam" }
        },
        {
          "matcher": { "type": "FROM_DOMAIN_REPUTATION_EQUALS", "listIds": ["disposable-email-domains"], "key": ">0.5" },
          "action": { "type": "MOVE_TO", "key": "Spam" }
        },
        {
          "matcher": { "type": "FROM_DOMAIN_REPUTATION_EQUALS", "listIds": ["hagezi-nrd7"], "key": ">0.5" },
          "action": { "type": "MOVE_TO", "key": "Spam" }
        }
      ]
    }
  ]
}
